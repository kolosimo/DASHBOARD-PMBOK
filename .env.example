# ---------------------------------------------------------------------------
# Cruscotto commesse Climosfera: variabili d'ambiente
# Copia questo file in ".env" e compila i valori. ".env" non va mai su git.
# ---------------------------------------------------------------------------

# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development
LOG_LEVEL=info

# App
APP_NAME=cruscotto-commesse
# Genera con: node ace generate:key
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Sessione (cookie httpOnly). Valori: cookie | memory | database
SESSION_DRIVER=cookie

# Database PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=cruscotto
DB_PASSWORD=cruscotto
DB_DATABASE=cruscotto_dev

# Login
# oidc = Microsoft Entra ID (produzione). dev = login di sviluppo senza password.
# Il server RIFIUTA di avviarsi con NODE_ENV=production e AUTH_MODE=dev.
AUTH_MODE=dev

# Microsoft Entra ID (OIDC, authorization code + PKCE, lato server)
# Issuer single-tenant: https://login.microsoftonline.com/<ID-TENANT>/v2.0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3333/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3333/accesso
OIDC_SCOPES=openid profile email

# Email (separate da virgola) che diventano admin al primo accesso
ADMIN_EMAILS=

# Job pianificati in-process (snapshot settimanali). Default: attivi fuori dai test.
SCHEDULER_ATTIVO=true
