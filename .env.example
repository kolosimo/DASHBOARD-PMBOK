# ---------------------------------------------------------------------------
# Cruscotto commesse Climosfera: variabili d'ambiente
# Copia questo file in ".env" e compila i valori. ".env" non va mai su git.
# ---------------------------------------------------------------------------

# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development
LOG_LEVEL=info

# App
APP_NAME=cruscotto-commesse
# Genera con: node ace generate:key
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Sessione (cookie httpOnly; "secure" automatico se APP_URL è https). Valori: cookie | memory | database
SESSION_DRIVER=cookie
# Scadenza per inattività (es. 8h, 30m). Default 10h.
SESSION_INATTIVITA=10h

# Database PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=cruscotto
DB_PASSWORD=cruscotto
DB_DATABASE=cruscotto_dev

# Login
# Un solo valore:
#   locale = email e password gestite dall'admin dell'app (pilota). Primo admin:
#            node ace utenti:crea-admin --email nome.cognome@climosfera.it --nome "Nome Cognome"
#   oidc   = Microsoft Entra ID (Microsoft 365).
#   dev    = login di sviluppo senza password (più password e Microsoft 365 per le prove).
# Il server RIFIUTA di avviarsi con NODE_ENV=production e AUTH_MODE=dev.
AUTH_MODE=dev

# Microsoft Entra ID (OIDC, authorization code + PKCE, lato server)
# Issuer single-tenant: https://login.microsoftonline.com/<ID-TENANT>/v2.0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3333/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3333/accesso
OIDC_SCOPES=openid profile email

# Email (separate da virgola) che diventano admin al primo accesso
ADMIN_EMAILS=

# HTTPS diretto da Node (produzione, certificato PFX). Vuoti = solo HTTP.
# HTTPS_PFX_PATH=C:\Cruscotto\config\cruscotto.pfx
# HTTPS_PFX_PASSPHRASE=
# HTTPS_REINDIRIZZA_DA_PORTA=80

# Job pianificati in-process (snapshot settimanali). Default: attivi fuori dai test.
SCHEDULER_ATTIVO=true
