# ---------------------------------------------------------------------------
# Cruscotto commesse Climosfera: configurazione del server (produzione)
# Generato da installa.ps1 il {{DATA}}. Contiene segreti: la cartella
# C:\app\config è leggibile solo da amministratori, SYSTEM e dall'account
# del servizio. Dopo una modifica: .\servizio.ps1 -Azione restart
# ---------------------------------------------------------------------------

# Node
TZ=UTC
HOST=0.0.0.0
PORT={{PORTA}}
NODE_ENV=production
LOG_LEVEL=info

# App
APP_NAME=cruscotto-commesse
APP_KEY={{APP_KEY}}
APP_URL={{APP_URL}}

# HTTPS diretto da Node con il certificato AD CS esportato in PFX (AES256-SHA256)
HTTPS_PFX_PATH={{PFX_PATH}}
HTTPS_PFX_PASSPHRASE={{PFX_PASSPHRASE}}
# Porta http che reindirizza a https (vuoto = disattivata)
HTTPS_REINDIRIZZA_DA_PORTA={{PORTA_REDIRECT}}

# Sessione: cookie httpOnly, "secure" perché APP_URL è https
SESSION_DRIVER=cookie
SESSION_INATTIVITA=10h

# Database PostgreSQL 17 (solo localhost)
DB_HOST=127.0.0.1
DB_PORT={{DB_PORTA}}
DB_USER={{DB_UTENTE}}
DB_PASSWORD={{DB_PASSWORD}}
DB_DATABASE={{DB_NOME}}

# Accesso
#   locale = email e password gestite dall'admin dell'app (pilota)
#   oidc   = Microsoft 365 (servono le variabili OIDC_* qui sotto)
AUTH_MODE=locale

# Microsoft 365 (Entra ID), da compilare quando si passa ad AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI={{APP_URL}}/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI={{APP_URL}}/accesso
OIDC_SCOPES=openid profile email
ADMIN_EMAILS=

# Job pianificati in-process (snapshot settimanali)
SCHEDULER_ATTIVO=true
