{{--
  Cambio password: obbligatorio al primo accesso o dopo un reset dell'admin,
  volontario per chi è già entrato (serve la password attuale).
  Variabili: obbligatorio, nome, minimo, errore, fatto
--}}
@component('layouts/app', { titolo: 'Cambia password' })
  <div class="accesso">
    <div>
      <div class="eyebrow">Cruscotto commesse Climosfera</div>
      <h2>Scegli una nuova password</h2>
      @if(obbligatorio)
        <p class="muted">
          Ciao {{ nome }}: stai usando una password temporanea. Prima di entrare scegline una tua.
        </p>
      @end
    </div>
    @if(fatto)
      <div class="messaggio ok" role="status" data-testid="password-cambiata">
        <p>Password cambiata.</p>
      </div>
      <p><a class="btn" href="/">Torna al cruscotto</a></p>
    @else
      @if(errore)
        <div class="messaggio errore" role="alert" data-testid="errore-password">
          <p>{{ errore }}</p>
        </div>
      @end
      <form class="panel campi" method="POST" action="/accesso/cambia-password" data-testid="form-cambia-password">
        {{ csrfField() }}
        @if(!obbligatorio)
          <label style="flex:1 1 100%">
            Password attuale
            <input
              type="password"
              name="password_attuale"
              autocomplete="current-password"
              required
              maxlength="200"
            />
          </label>
        @end
        <label style="flex:1 1 100%">
          Nuova password (almeno {{ minimo }} caratteri)
          <input
            type="password"
            name="nuova_password"
            autocomplete="new-password"
            required
            minlength="{{ minimo }}"
            maxlength="200"
          />
        </label>
        <label style="flex:1 1 100%">
          Ripeti la nuova password
          <input
            type="password"
            name="conferma_password"
            autocomplete="new-password"
            required
            minlength="{{ minimo }}"
            maxlength="200"
          />
        </label>
        <button class="btn primary" type="submit">Salva la nuova password</button>
      </form>
      <p class="muted">
        Consiglio: una frase di più parole è facile da ricordare e difficile da indovinare.
      </p>
    @end
  </div>
@end
