{{--
  Pagina di accesso. Mostra solo il metodo attivo (AUTH_MODE):
  locale = email e password; oidc = Microsoft 365; dev = tutti, più il login di sviluppo.
  Variabili: modalitaAuth, accessoLocale, accessoOidc, oidcDisponibile, utentiDev,
  ritorno, uscito, errore, email
--}}
@component('layouts/app', { titolo: 'Accesso' })
  <div class="accesso">
    <div>
      <div class="eyebrow">Cruscotto commesse Climosfera</div>
      <h1>Accedi</h1>
      <p class="tagline">Think. Manage. Do.</p>
      @if(modalitaAuth === 'locale')
        <p class="muted">Usa l'email e la password che ti ha dato l'amministratore dell'app.</p>
      @elseif(modalitaAuth === 'oidc')
        <p class="muted">Usa il tuo account Microsoft 365 aziendale.</p>
      @end
    </div>
    @if(uscito)
      <div class="messaggio ok" role="status">
        <p>Sei uscito dall'app.</p>
      </div>
    @end
    @if(errore)
      <div class="messaggio errore" role="alert" data-testid="errore-accesso">
        <p>{{ errore }}</p>
      </div>
    @end

    @if(accessoLocale)
      <form class="panel campi" method="POST" action="/accesso" data-testid="form-accesso-locale">
        {{ csrfField() }}
        <input type="hidden" name="ritorno" value="{{ ritorno }}" />
        <label style="flex:1 1 100%">
          Email
          <input
            type="email"
            name="email"
            value="{{ email }}"
            autocomplete="username"
            required
            autofocus
            maxlength="254"
          />
        </label>
        <label style="flex:1 1 100%">
          Password
          <input
            type="password"
            name="password"
            autocomplete="current-password"
            required
            maxlength="200"
          />
        </label>
        <button class="btn primary" type="submit">Accedi</button>
      </form>
      @if(modalitaAuth === 'locale')
        <p class="muted">
          Password dimenticata o accesso bloccato? Chiedi all'amministratore dell'app di reimpostarla.
        </p>
      @end
    @end

    @if(accessoOidc)
      @if(oidcDisponibile)
        <p>
          <a class="btn {{ accessoLocale ? '' : 'primary' }}" href="/auth/login?ritorno={{ encodeURIComponent(ritorno) }}">
            Accedi con Microsoft 365
          </a>
        </p>
      @elseif(modalitaAuth === 'oidc')
        <div class="messaggio errore">
          <p>Il login Microsoft 365 non è ancora configurato su questo server.</p>
        </div>
      @end
    @end

    @if(modalitaAuth === 'dev')
      @component('components/pannello', {
        titolo: 'Login di sviluppo',
        nota: 'solo con AUTH_MODE=dev',
      })
        <p class="muted" style="margin:0 0 10px">
          Scegli un utente dei dati di esempio. In produzione questa sezione non esiste e il server rifiuta di partire con AUTH_MODE=dev.
        </p>
        <ul class="elenco-dev">
          @each(u in utentiDev)
            <li>
              <a
                href="/dev/login?come={{ u.email.split('@')[0] }}&ritorno={{ encodeURIComponent(ritorno) }}"
                data-testid="dev-{{ u.email.split('@')[0] }}"
              >
                <b>{{ u.nome }}</b>
                <span class="ruolo">{{ u.ruolo }} · {{ u.email.split('@')[0] }}</span>
              </a>
            </li>
          @end
        </ul>
      @end
    @end
  </div>
@end
