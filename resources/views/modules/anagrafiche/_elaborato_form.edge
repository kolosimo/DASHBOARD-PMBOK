{{--
  Form dell'elaborato (nuovo o modifica) oppure riepilogo in sola lettura
  (usato nella pagina del conflitto 409).
  Variabili: commessa, elaborato (null se nuovo), errori, valori, discipline,
  persone, milestone, classi, solaLettura?
--}}
@if(solaLettura)
  <div class="panel tbl" data-testid="elaborato-attuale">
    <div class="panel-h">
      <h3>Elaborato {{ elaborato.codice }} com'è ora</h3>
      <span class="note">versione {{ elaborato.version }}</span>
    </div>
    <table>
      <tbody>
        <tr>
          <th>Codice</th>
          <td class="code">{{ elaborato.codice }}</td>
        </tr>
        <tr>
          <th>Titolo</th>
          <td>{{ elaborato.titolo }}</td>
        </tr>
        <tr>
          <th>Budget</th>
          <td class="num">{{ formato.oreEsatte(elaborato.budgetMinuti) }}</td>
        </tr>
        <tr>
          <th>Classe di servizio</th>
          <td>{{ elaborato.classeServizio }}</td>
        </tr>
        <tr>
          <th>Data fissa</th>
          <td class="num">{{ formato.data(elaborato.dataFissa) }}</td>
        </tr>
      </tbody>
    </table>
  </div>
@else
  @let(val = (k, d) => (valori[k] !== undefined ? valori[k] : d))
  @let(el = elaborato || {})
  @if(errori.generale)
    <div class="messaggio errore" role="alert" data-testid="errore-generale">
      <p>{{ errori.generale }}</p>
    </div>
  @elseif(Object.keys(errori).length)
    <div class="messaggio errore" role="alert">
      <p>Controlla i campi segnalati.</p>
    </div>
  @end

  <form
    class="panel campi"
    method="POST"
    action="/commesse/{{ commessa.id }}/elaborati{{ elaborato ? '/' + elaborato.id : '' }}"
    data-testid="form-elaborato"
  >
    {{ csrfField() }}
    @if(elaborato)
      <input type="hidden" name="version" value="{{ elaborato.version }}" />
    @end

    <label>
      
      
      Codice


      <input
        type="text"
        name="codice"
        value="{{ val('codice', el.codice || '') }}"
        maxlength="40"
        required
        style="width:140px"
      />
      @!component('modules/anagrafiche/_errore', { testo: errori.codice })
    </label>
    <label style="flex:1 1 320px">
      
      
      Titolo


      <input
        type="text"
        name="titolo"
        value="{{ val('titolo', el.titolo || '') }}"
        maxlength="300"
        required
      />
      @!component('modules/anagrafiche/_errore', { testo: errori.titolo })
    </label>
    <label>
      
      
      Disciplina


      <select name="disciplina_id" required>
        <option value="">scegli…</option>
        @each(d in discipline)
          @if(d.attiva || d.id === el.disciplinaId)
            <option
              value="{{ d.id }}"
              {{
                String(val('disciplina_id', el.disciplinaId)) === String(d.id)
                  ? 'selected'
                  : ''
              }}
            >
              {{ d.codice }}
              ·
              {{ d.nome }}
            </option>
          @end
        @end
      </select>
      @!component('modules/anagrafiche/_errore', { testo: errori.disciplina_id })
    </label>
    <label>
      
      
      Budget (ore)


      <input
        type="text"
        inputmode="decimal"
        name="budget_ore"
        value="{{
          val(
            'budget_ore',
            elaborato
              ? formato.numero(
                  el.budgetMinuti / 60,
                  Number.isInteger(el.budgetMinuti / 60) ? 0 : 2,
                )
              : '',
          )
        }}"
        style="width:100px"
      />
      @!component('modules/anagrafiche/_errore', { testo: errori.budget_ore })
    </label>
    <label>
      
      
      Classe di servizio


      <select name="classe_servizio">
        @each(c in classi)
          <option
            value="{{ c.valore }}"
            {{
              val('classe_servizio', el.classeServizio || 'standard') === c.valore
                ? 'selected'
                : ''
            }}
          >
            {{ c.etichetta }}
          </option>
        @end
      </select>
      @!component('modules/anagrafiche/_errore', { testo: errori.classe_servizio })
    </label>
    <label>
      
      
      Data fissa


      <input type="date" name="data_fissa" value="{{ val('data_fissa', el.dataFissa || '') }}" />
      @!component('modules/anagrafiche/_errore', { testo: errori.data_fissa })
    </label>
    <label>
      
      
      Responsabile


      <select name="responsabile_id">
        <option value="">nessuno</option>
        @each(u in persone)
          <option
            value="{{ u.id }}"
            {{
              String(val('responsabile_id', el.responsabileId)) === String(u.id)
                ? 'selected'
                : ''
            }}
          >
            {{ u.nome }}{{ u.nota ? ' (' + u.nota + ')' : '' }}
          </option>
        @end
      </select>
      @!component('modules/anagrafiche/_errore', { testo: errori.responsabile_id })
    </label>
    <label>
      
      
      Milestone


      <select name="milestone_id">
        <option value="">nessuna</option>
        @each(m in milestone)
          <option
            value="{{ m.id }}"
            {{ String(val('milestone_id', el.milestoneId)) === String(m.id) ? 'selected' : '' }}
          >
            {{ m.titolo }}
            ·
            {{ formato.dataBreve(m.dataPrevista) }}
          </option>
        @end
      </select>
      @!component('modules/anagrafiche/_errore', { testo: errori.milestone_id })
    </label>
    <button class="btn primary" type="submit">{{ elaborato ? 'Salva' : 'Crea elaborato' }}</button>
    <a class="btn ghost" href="/commesse/{{ commessa.id }}/anagrafica#pannello-elaborati">
      Annulla
    </a>
  </form>
@end
