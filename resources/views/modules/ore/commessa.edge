@component('layouts/app', { titolo: 'Ore della commessa' })
  <div class="head">
    <div>
      <div class="eyebrow">Ore · settimana {{ formato.settimana(settimana) }}</div>
      <h2>Ore della commessa</h2>
      <p>
        Ore registrate per elaborato nella settimana dal
        {{ formato.data(settimana) }}
        al
        {{ formato.data(domenica) }}
        e cumulate fino a quella data. Sono il costo effettivo (AC) dell’EVM.
      </p>
    </div>
  </div>

  <nav class="campi" aria-label="Settimana" style="align-items:center">
    <a
      class="btn"
      href="/commesse/{{ commessa.id }}/ore?settimana={{ precedente }}"
      data-testid="settimana-precedente"
    >
      ←
      {{ formato.settimana(precedente) }}
    </a>
    <b>{{ formato.settimana(settimana) }}</b>
    @if(successiva)
      <a
        class="btn"
        href="/commesse/{{ commessa.id }}/ore?settimana={{ successiva }}"
        data-testid="settimana-successiva"
      >
        {{ formato.settimana(successiva) }}
        →
      </a>
    @end
  </nav>

  <div
    id="ore-commessa"
    hx-get="/commesse/{{ commessa.id }}/ore?settimana={{ settimana }}"
    hx-trigger="evento-commessa[detail.tipo === 'ore.registrate'] from:body, polling-commessa from:body"
    hx-select="#ore-commessa"
    hx-swap="outerHTML"
    style="display:flex;flex-direction:column;gap:14px"
  >
    <div class="kpis">
      @!component('components/kpi', {
        etichetta: 'Ore nella settimana',
        valore: formato.oreEsatte(ore.totaleSettimanaMinuti),
      })
      @!component('components/kpi', {
        etichetta: glossario.AC.sigla + ' · ' + glossario.AC.nome.toLowerCase(),
        valore: formato.ore(ore.totaleCommessaMinuti),
        sotto: 'dall’inizio al ' + formato.data(domenica),
      })
      @!component('components/kpi', {
        etichetta: 'Budget ore',
        valore: formato.ore(budgetTotale),
        sotto: 'somma dei budget degli elaborati',
      })
    </div>
    @component('components/pannello', { titolo: 'Ore per elaborato', tabella: true })
      <table data-testid="ore-per-elaborato">
        <thead>
          <tr>
            <th>Elaborato</th>
            <th class="r">Settimana</th>
            <th class="r">A fine settimana</th>
            <th class="r">Budget</th>
            <th class="r">Budget residuo</th>
          </tr>
        </thead>
        <tbody>
          @each(r in ore.perElaborato)
            <tr data-testid="elaborato-{{ r.codice }}">
              <td>
                <span class="code">{{ r.codice }}</span>
                <div class="muted" style="font-size:12px">{{ r.titolo }}</div>
              </td>
              <td class="r num">{{ formato.oreEsatte(r.minutiSettimana) }}</td>
              <td class="r num">{{ formato.oreEsatte(r.minutiTotali) }}</td>
              <td class="r num">{{ formato.ore(r.budgetMinuti) }}</td>
              <td class="r num {{ r.minutiTotali > r.budgetMinuti ? 'age-old' : '' }}">
                {{ formato.oreEsatte(r.budgetMinuti - r.minutiTotali) }}
              </td>
            </tr>
          @else
            <tr>
              <td colspan="5" class="muted">La commessa non ha ancora elaborati.</td>
            </tr>
          @end
        </tbody>
        <tfoot>
          <tr>
            <td><b>Totale commessa</b></td>
            <td class="r num" data-testid="totale-settimana">
              <b>{{ formato.oreEsatte(ore.totaleSettimanaMinuti) }}</b>
            </td>
            <td class="r num" data-testid="totale-commessa">
              <b>{{ formato.oreEsatte(ore.totaleCommessaMinuti) }}</b>
            </td>
            <td class="r num"><b>{{ formato.ore(budgetTotale) }}</b></td>
            <td class="r num">
              <b>{{ formato.oreEsatte(budgetTotale - ore.totaleCommessaMinuti) }}</b>
            </td>
          </tr>
        </tfoot>
      </table>
    @end
    @if(persone)
      @component('components/pannello', {
        titolo: 'Ore per persona',
        nota: 'in ordine alfabetico · solo per il controllo di commessa, non per valutare le persone',
        tabella: true,
      })
        <table data-testid="ore-per-persona">
          <thead>
            <tr>
              <th>Persona</th>
              <th class="r">Settimana</th>
              <th class="r">A fine settimana</th>
            </tr>
          </thead>
          <tbody>
            @each(p in persone)
              <tr>
                <td>{{ p.nome }}</td>
                <td class="r num">{{ formato.oreEsatte(p.minutiSettimana) }}</td>
                <td class="r num">{{ formato.oreEsatte(p.minutiTotali) }}</td>
              </tr>
            @else
              <tr>
                <td colspan="3" class="muted">Nessuna ora registrata.</td>
              </tr>
            @end
          </tbody>
        </table>
      @end
    @elseif(!attivaImpostazione && (utente.ruolo === 'admin' || utente.ruolo === 'pm'))
      <p class="muted" style="font-size:12.5px;margin:0" data-testid="per-persona-spente">
        Le ore per persona sono disattivate (impostazione “ore.per_persona_visibili”).
      </p>
    @end
  </div>
@end
