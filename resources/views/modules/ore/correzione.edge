@component('layouts/app', { titolo: 'Correzione ore', voceAttiva })
  <div class="head">
    <div>
      <div class="eyebrow">Amministrazione · ore</div>
      <h2>Correzione delle ore di una persona</h2>
      <p>
        Solo per correggere errori segnalati dalla persona interessata. Ogni modifica richiede il motivo e finisce nel registro di audit con il tuo nome. Le proprie ore ognuno le registra dalla pagina “Le mie ore”.
      </p>
    </div>
  </div>

  <form class="campi" method="GET" action="/ore/correzione">
    <label>
      Persona
      <select name="utente" data-testid="scelta-persona">
        <option value="">— scegli —</option>
        @each(u in utenti)
          <option value="{{ u.id }}" {{ persona && persona.id === u.id ? 'selected' : '' }}>
            {{ u.nome }}
          </option>
        @end
      </select>
    </label>
    <input type="hidden" name="settimana" value="{{ settimana }}" />
    <button class="btn" type="submit">Apri</button>
  </form>
  @if(persona && ts)
    <label style="display:flex;flex-direction:column;gap:3px;max-width:560px">
      
      Motivo della correzione (obbligatorio, finisce nell’audit)

      <input type="text" id="motivo" name="motivo" maxlength="300" required data-testid="motivo" />
    </label>
    @include('modules/ore/_griglia')
  @end
@end
