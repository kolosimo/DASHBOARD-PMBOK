@component('layouts/app', { titolo: 'Le mie commesse', voceAttiva })
  <div class="head">
    <div>
      <div class="eyebrow">
        Settimana
        {{ formato.settimana(settimana) }}
        ·
        {{ formato.dataEstesa(oggi) }}
      </div>
      <h2>Le mie commesse</h2>
      <p>
        @if(utente.ruolo === 'admin' || utente.ruolo === 'direzione')
          Tutte le commesse dello studio.
        @else
          Le commesse di cui fai parte. Si apre una commessa cliccando sul codice.
        @end
      </p>
    </div>
  </div>
  @component('components/pannello', { tabella: true })
    <table data-testid="elenco-commesse">
      <thead>
        <tr>
          <th>Commessa</th>
          <th>Descrizione</th>
          <th>PM</th>
          <th>Il mio ruolo</th>
          <th class="r">Elaborati</th>
          <th>Prossima milestone</th>
          <th>Stato</th>
        </tr>
      </thead>
      <tbody>
        @each(c in commesse)
          <tr>
            <td><a class="code" href="/commesse/{{ c.id }}">{{ c.codice }}</a></td>
            <td>{{ c.nome }}</td>
            <td>{{ formato.testo(c.pmNome) }}</td>
            <td>
              {{
                c.ruoloCommessa ||
                (utente.ruolo === 'direzione'
                  ? 'direzione'
                  : utente.ruolo === 'admin'
                    ? 'admin'
                    : 'n.d.')
              }}
            </td>
            <td class="r num">{{ c.numeroElaborati }}</td>
            <td>
              @if(c.prossimaMilestone)
                {{ c.prossimaMilestone.titolo }}
                ·
                <span class="num">{{ formato.dataBreve(c.prossimaMilestone.data) }}</span>
              @else
                <span class="muted">n.d.</span>
              @end
            </td>
            <td>
              @!component('components/pill', {
                classe: c.stato === 'attiva' ? 'g' : 'n',
                testo: c.stato,
              })
            </td>
          </tr>
        @else
          <tr>
            <td colspan="7" class="muted">
              Non fai ancora parte di nessuna commessa. Chiedi al PM di aggiungerti al team.
            </td>
          </tr>
        @end
      </tbody>
    </table>
  @end
@end
