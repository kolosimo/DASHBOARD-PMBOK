@component('layouts/app', { titolo: 'Avanzamento EVM' })
  <style>
    /* Griglia KPI della sola pagina EVM: 9 riquadri in 3 colonne (3 righe piene),
       una colonna sugli schermi stretti. Il CSS condiviso resta invariato. */
    .kpis.kpis-evm {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    @media (max-width: 560px) {
      .kpis.kpis-evm {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  </style>
  <div class="head">
    <div>
      <div class="eyebrow">Earned Value in ore · {{ formato.settimana(riepilogo.settimana) }}</div>
      <h2>Avanzamento per elaborato</h2>
      <p>
        Il valore guadagnato si calcola dallo stato dell'elaborato, non da una percentuale dichiarata, con i pesi congelati nella baseline. Le settimane passate si leggono dagli snapshot e non cambiano; solo la settimana corrente è calcolata al momento.
      </p>
    </div>
    <div>
      @if(attiva)
        <div class="muted" data-testid="baseline-attiva">
          Baseline n. {{ attiva.numero }} approvata il {{ formato.data(attiva.approvataIl) }}
          @if(attiva.approvataDa)
            da {{ attiva.approvataDa }}
          @end
        </div>
      @end
      @if(bozza)
        <div class="muted">Bozza n. {{ bozza.numero }} in preparazione</div>
      @end
      @if(puoModificare)
        <a class="btn" href="/commesse/{{ commessa.id }}/evm/baseline" data-testid="link-baseline">
          {{ bozza ? 'Continua la bozza' : (attiva ? 'Nuova baseline' : 'Prepara la baseline') }}
        </a>
      @end
    </div>
  </div>

  @include('modules/evm/_contenuto')
@end
