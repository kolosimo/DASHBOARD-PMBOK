{
  "name": "cruscotto-commesse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Cruscotto commesse Climosfera: Last Planner, Kanban, ore ed EVM in ore",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "test:unit": "node ace test unit",
    "test:functional": "node ace test functional",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "controlla-dipendenze": "node scripts/controlla-dipendenze-native.mjs",
    "verifica": "node scripts/verifica.mjs",
    "e2e": "playwright test",
    "screenshot": "playwright test -c playwright.screenshot.config.ts",
    "vendorizza": "node scripts/vendorizza.mjs",
    "db:migra": "node ace migration:run",
    "db:seed": "node ace db:seed",
    "db:ricrea": "node ace migration:fresh --seed",
    "db:locale": "node scripts/db-locale.mjs"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#modules/*": "./app/modules/*.js",
    "#domain/*": "./app/domain/*.js",
    "#shared/*": "./app/shared/*.js",
    "#ui/*": "./app/ui/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "8.5.2",
    "@adonisjs/eslint-config": "3.1.0",
    "@adonisjs/prettier-config": "1.5.0",
    "@adonisjs/transmit-client": "1.1.0",
    "@adonisjs/tsconfig": "2.0.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "@japa/assert": "4.2.0",
    "@japa/plugin-adonisjs": "5.2.0",
    "@japa/runner": "5.3.0",
    "@playwright/test": "1.56.1",
    "@poppinss/ts-exec": "1.4.4",
    "@types/luxon": "3.7.5",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "alpinejs": "3.17.4",
    "eslint": "10.11.0",
    "hot-hook": "1.0.0",
    "htmx.org": "2.0.11",
    "oauth2-mock-server": "9.2.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "youch": "4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "10.1.0",
    "@adonisjs/bouncer": "4.0.1",
    "@adonisjs/core": "7.5.2",
    "@adonisjs/lucid": "22.4.2",
    "@adonisjs/session": "8.1.0",
    "@adonisjs/shield": "9.0.0",
    "@adonisjs/static": "2.0.1",
    "@adonisjs/transmit": "3.0.2",
    "@adonisjs/vite": "6.0.2",
    "@vinejs/vine": "4.4.0",
    "edge.js": "6.5.1",
    "luxon": "3.7.2",
    "openid-client": "6.8.8",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/modules/**/*controller.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
