# Valori per "node ace test": completi, così i test girano anche senza ".env".
# Le variabili di processo vincono: ogni agente può usare DB e porta propri, per esempio
#   DB_DATABASE=cruscotto_test_a1 PORT=3401 npm run verifica
TZ=UTC
HOST=localhost
PORT=3339
LOG_LEVEL=error
APP_NAME=cruscotto-commesse
# Chiave SOLO per i test, non usarla altrove
APP_KEY=chiave-solo-per-i-test-non-usare-in-produzione-000
APP_URL=http://localhost:3339
SESSION_DRIVER=memory
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=cruscotto
DB_PASSWORD=cruscotto
DB_DATABASE=cruscotto_test
AUTH_MODE=dev
ADMIN_EMAILS=admin.nuovo@climosfera.example
SCHEDULER_ATTIVO=false
